# Agenttic AI Orchestration System - Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# Application Settings
# ===========================================
APP_NAME=Agenttic AI Orchestration System
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# API Settings
API_V1_PREFIX=/api/v1
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===========================================
# Database (PostgreSQL with pgvector)
# ===========================================
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=agenttic
POSTGRES_PASSWORD=agenttic_secret
POSTGRES_DB=agenttic
# DATABASE_URL=postgresql+asyncpg://agenttic:agenttic_secret@postgres:5432/agenttic

# ===========================================
# Redis
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_URL=redis://redis:6379/0

# ===========================================
# Vector Store (Qdrant)
# ===========================================
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=agenttic_documents

# ===========================================
# LLM Providers (choose one or both)
# ===========================================
# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSION=3072

# Anthropic (optional)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-opus-20240229

# LangChain/LangSmith (optional)
LANGCHAIN_API_KEY=your-langchain-api-key
LANGCHAIN_PROJECT=agenttic
LANGCHAIN_TRACING_V2=true

# ===========================================
# n8n Integration
# ===========================================
N8N_HOST=n8n
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
WEBHOOK_URL=http://localhost:5678
GENERIC_TIMEZONE=America/Bogota
TZ=America/Bogota

N8N_WEBHOOK_URL=http://n8n:5678/webhook
N8N_API_URL=http://n8n:5678/api/v1
N8N_API_KEY=your-n8n-api-key

N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin123
N8N_ENCRYPTION_KEY=your-32-char-encryption-key-change-in-production

# ===========================================
# Frontend
# ===========================================
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5678"]

# ===========================================
# Scraper Settings
# ===========================================
SCRAPER_TIMEOUT=30
SCRAPER_MAX_RETRIES=3
SCRAPER_RETRY_DELAY=2.0
SCRAPER_USER_AGENT=Agenttic/1.0 (+https://agenttic.ai)

# ===========================================
# Agent Settings
# ===========================================
AGENT_MAX_ITERATIONS=10
AGENT_TEMPERATURE=0.1
AGENT_MAX_TOKENS=4000

# ===========================================
# RAG Settings
# ===========================================
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7

# ===========================================
# File Upload
# ===========================================
MAX_FILE_SIZE=52428800
ALLOWED_EXTENSIONS=[".pdf", ".csv", ".txt", ".md", ".docx", ".xlsx"]
UPLOAD_DIR=./uploads

# ===========================================
# Email (SMTP) - for notifications
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@agenttic.ai

# ===========================================
# Telegram Bot - for notifications
# ===========================================
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# ===========================================
# WhatsApp (Meta Cloud API) - for notifications
# ===========================================
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_API_KEY=your-whatsapp-api-key
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# ===========================================
# Slack - for notifications
# ===========================================
SLACK_WEBHOOK_URL=your-slack-webhook-url
SLACK_BOT_TOKEN=your-slack-bot-token

# ===========================================
# Webhook Security
# ===========================================
WEBHOOK_SECRET=your-webhook-secret-change-in-production

# ===========================================
# Monitoring (Grafana)
# ===========================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin123